# Copy to .env, fill in, and load it from your process manager. NEVER commit the real .env.
# Encryption key for the data file (32 random bytes, base64):   openssl rand -base64 32
PAYPILOT_DATA_KEY=
# First admin account (created only when there are no users). If the password is empty a random one is printed once.
PAYPILOT_ADMIN_EMAIL=you@yourdomain.com
PAYPILOT_ADMIN_PASSWORD=
# Listen address. Keep 127.0.0.1 behind a reverse proxy. Use 0.0.0.0 only inside a container.
PAYPILOT_BIND=127.0.0.1
PORT=8080
# Behind Cloudflare / a reverse proxy that terminates HTTPS:
PAYPILOT_TRUST_PROXY=true
PAYPILOT_FORCE_HTTPS=true
# Extra browser origins allowed to call the API with cookies (usually none). Comma separated.
PAYPILOT_ALLOWED_ORIGINS=
# Optional AI assistant (key stays on the server)
GEMINI_API_KEY=
# Optional: terminate TLS in Java instead of a proxy
PAYPILOT_TLS_KEYSTORE=
PAYPILOT_TLS_PASSWORD=
# Optional paths
PAYPILOT_DATA=paypilot-data.json
PAYPILOT_SECLOG=security.log
PAYPILOT_BACKUP_DIR=backups
