      <!-- =======================================================================
           VIEW: DASHBOARD (ADAPTS FOR EASY MODE & PRO MODE)
           ======================================================================= -->
      <div id="pane-dashboard" class="view-pane active">
        <!-- Payday Countdown Banner -->
        <div style="background: linear-gradient(90deg, rgba(255,138,61,0.15), rgba(45,212,191,0.15)); border: 1px solid var(--border-film); border-radius: var(--radius-md); padding: 16px 20px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px;">
          <div style="display: flex; align-items: center; gap: 14px;">
            <div style="width: 48px; height: 48px; border-radius: 50%; border: 3px solid var(--cinema-orange); display: flex; align-items: center; justify-content: center; font-family: var(--font-headline); font-size: 18px; color: var(--cinema-orange);" id="payday-days-circle">5d</div>
            <div>
              <h4 style="color: var(--cinema-cream); margin-bottom: 2px;">PAYDAY COUNTDOWN: 5 DAYS REMAINING</h4>
              <p style="font-size: 13px; color: var(--cinema-muted);">Monthly disbursement scheduled for March 31, 2026 • 0 pending advance loans.</p>
            </div>
          </div>
          <button class="btn btn-orange" onclick="openWizard('payroll')">Run Payroll Now ➔</button>
        </div>

        <!-- EASY MODE: CA BUDDY PROMINENT HERO CARD -->
        <div class="card card-glow-orange easy-only" style="margin-bottom: 20px; border: 2px solid var(--cinema-orange); cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 16px; flex-wrap: wrap;" onclick="openCaBuddy()">
          <div style="display: flex; align-items: center; gap: 16px;">
            <div style="font-size: 38px;">💼</div>
            <div>
              <h3 style="color: var(--cinema-orange); margin-bottom: 4px;">ANALYSE MY BANK STATEMENT (CA BUDDY)</h3>
              <p style="font-size: 14px; color: var(--cinema-cream); margin: 0;">Upload statement ➔ auto-calculates GST, Income Tax, P&amp;L, and gives plain-language answers like a friendly chartered accountant.</p>
            </div>
          </div>
          <button class="btn btn-orange" style="font-size: 15px; padding: 10px 24px;">Analyse Now ➔</button>
        </div>

        <!-- EASY MODE: 4 BIG ACTION TILES -->
        <div id="easy-mode-actions" class="easy-mode-grid">
          <div class="easy-tile" onclick="openWizard('employee')">
            <div class="easy-tile-icon">👤</div>
            <div class="easy-tile-title">1. Add Person</div>
            <div class="easy-tile-desc">Add a worker, staff, or helper in 3 simple questions.</div>
          </div>
          <div class="easy-tile" onclick="openWizard('payroll')">
            <div class="easy-tile-icon">💰</div>
            <div class="easy-tile-title">2. Pay Salary</div>
            <div class="easy-tile-desc">Review working days and disburse this month's pay.</div>
          </div>
          <div class="easy-tile" onclick="openPayslipModal('EMP-101')">
            <div class="easy-tile-icon">📄</div>
            <div class="easy-tile-title">3. See My Payslip</div>
            <div class="easy-tile-desc">Clean salary slip with WhatsApp sharing &amp; simple explanation.</div>
          </div>
          <div class="easy-tile" onclick="openWizard('tax')">
            <div class="easy-tile-icon">🧮</div>
            <div class="easy-tile-title">4. Calculate Tax</div>
            <div class="easy-tile-desc">See which regime saves you more money without math.</div>
          </div>
        </div>

        <!-- PRO MODE: FULL METRICS & KPI STRIP -->
        <div id="pro-mode-dashboard" class="pro-only">
          <div class="grid-4" style="margin-bottom: 24px;">
            <div class="card card-glow-orange">
              <span class="form-label">Total Monthly Payroll <button class="help-tooltip-btn" onclick="explainTerm('payroll')">?</button></span>
              <div class="font-mono money-val" style="font-size: 26px; font-weight: 700; color: var(--cinema-orange);">₹5,90,000</div>
              <span style="font-size: 11px; color: var(--cinema-emerald);">↑ 4.2% on-schedule</span>
            </div>
            <div class="card card-glow-teal">
              <span class="form-label">Active Headcount</span>
              <div class="font-mono" style="font-size: 26px; font-weight: 700; color: var(--cinema-teal);">10 Personnel</div>
              <span style="font-size: 11px; color: var(--cinema-muted);">7 Regular, 3 Kiosk/Wages</span>
            </div>
            <div class="card card-glow-gold">
              <span class="form-label">Payroll Health Score</span>
              <div class="font-mono" style="font-size: 26px; font-weight: 700; color: var(--cinema-gold);">94 / 100</div>
              <span style="font-size: 11px; color: var(--cinema-gold);">⭐ Tier A Optimized</span>
            </div>
            <div class="card card-glow-orange">
              <span class="form-label">TDS Withheld (Tax) <button class="help-tooltip-btn" onclick="explainTerm('tds')">?</button></span>
              <div class="font-mono money-val" style="font-size: 26px; font-weight: 700; color: var(--cinema-cream);">₹48,200</div>
              <span style="font-size: 11px; color: var(--cinema-muted);">Form 24Q Ready</span>
            </div>
          </div>

          <!-- Pure SVG Charts -->
          <div class="grid-2" style="margin-bottom: 24px;">
            <div class="card">
              <h4 style="margin-bottom: 12px;">Monthly Cost Trend (Scale Labeled)</h4>
              <svg width="100%" height="180" viewBox="0 0 500 180" preserveAspectRatio="none">
                <line x1="40" y1="20" x2="40" y2="150" stroke="rgba(255,255,255,0.1)" stroke-width="1" />
                <line x1="40" y1="150" x2="480" y2="150" stroke="rgba(255,255,255,0.1)" stroke-width="1" />
                <path d="M 40 120 Q 140 105 240 115 T 380 75 T 480 50" fill="none" stroke="var(--cinema-orange)" stroke-width="3" />
                <circle cx="40" cy="120" r="4" fill="var(--cinema-orange)" />
                <circle cx="240" cy="115" r="4" fill="var(--cinema-orange)" />
                <circle cx="380" cy="75" r="4" fill="var(--cinema-orange)" />
                <circle cx="480" cy="50" r="4" fill="var(--cinema-orange)" />
                <text x="35" y="170" fill="var(--cinema-muted)" font-size="10" font-family="var(--font-mono)">DEC</text>
                <text x="235" y="170" fill="var(--cinema-muted)" font-size="10" font-family="var(--font-mono)">JAN</text>
                <text x="375" y="170" fill="var(--cinema-muted)" font-size="10" font-family="var(--font-mono)">FEB</text>
                <text x="465" y="170" fill="var(--cinema-muted)" font-size="10" font-family="var(--font-mono)">MAR</text>
              </svg>
            </div>

            <!-- Anomaly Explainer Card -->
            <div class="card" style="border-left: 4px solid var(--cinema-crimson);">
              <h4 style="color: var(--cinema-crimson); margin-bottom: 8px;">⚠️ Anomaly Explainer</h4>
              <p style="font-size: 13px; color: var(--cinema-cream); margin-bottom: 12px;" id="anomaly-text">
                EMP-103 (Rohan Verma): Net pay rose 34% because of a ₹25,000 performance bonus.
              </p>
              <div style="display: flex; gap: 10px;">
                <button class="btn btn-teal" style="min-height: 36px; padding: 6px 14px; font-size: 12px;" onclick="resolveAnomaly(true)">Looks Fine ✓</button>
                <button class="btn btn-glass" style="min-height: 36px; padding: 6px 14px; font-size: 12px; color: var(--cinema-crimson);" onclick="resolveAnomaly(false)">Flag for Review 🚩</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- =======================================================================
           VIEW: SHOP MODE (FOR SMALL BUSINESS OWNERS & VENDORS)
