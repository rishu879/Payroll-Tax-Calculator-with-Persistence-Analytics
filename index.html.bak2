<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>PayPilot Enterprise | Statutory Payroll & Tax Intelligence</title>
  <meta name="description" content="PayPilot Enterprise - Cinematic, accessible payroll & tax calculation system with persistence, analytics, and shop mode.">

  <!-- Google Fonts: Oswald (Headlines) & Nunito Sans (Body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,wght@0,300;0,400;0,600;0,700;0,800;1,400&family=Oswald:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

  <!-- Google Identity Services (GIS) OAuth 2.0 SDK -->
  <script src="https://accounts.google.com/gsi/client" async defer></script>
  <!-- Statement Parsers: PapaParse, SheetJS, PDF.js (Exact pinned CDNJS versions) -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>
  <script>
    if (window.pdfjsLib) {
      pdfjsLib.GlobalWorkerOptions.workerSrc = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';
    }
  </script>

  <style>
    /* =========================================================================
       1. CINEMATIC TOKENS, ACCESSIBILITY, AND BASE STYLES
       ========================================================================= */
    :root {
      --bg-void: #07060D;
      --bg-card: #0E0C18;
      --bg-card-subtle: #131022;
      --bg-card-hover: #1A162E;
      --border-film: rgba(255, 138, 61, 0.22);
      --border-subtle: rgba(255, 255, 255, 0.09);
      --border-focus: #FF8A3D;

      /* Signature Palette */
      --cinema-orange: #FF8A3D;
      --cinema-orange-glow: rgba(255, 138, 61, 0.35);
      --cinema-teal: #2DD4BF;
      --cinema-teal-glow: rgba(45, 212, 191, 0.35);
      --cinema-gold: #F4C95D;
      --cinema-gold-glow: rgba(244, 201, 93, 0.35);
      --cinema-cream: #F4EBDD;
      --cinema-muted: #B8B2C8;
      --cinema-crimson: #F43F5E;
      --cinema-emerald: #10B981;

      /* Typography & Scaling */
      --font-headline: 'Oswald', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-body: 'Nunito Sans', -apple-system, BlinkMacSystemFont, sans-serif;
      --font-mono: 'JetBrains Mono', 'Courier New', monospace;
      --base-font-size: 16px;

      /* Target Sizing */
      --tap-target: 44px;
      --radius-sm: 6px;
      --radius-md: 12px;
      --radius-lg: 20px;
      --radius-pill: 9999px;
      --shadow-cinema: 0 16px 40px -10px rgba(0, 0, 0, 0.8), 0 0 20px rgba(255, 138, 61, 0.05);

      --transition-smooth: all 0.28s cubic-bezier(0.16, 1, 0.3, 1);
    }

    [data-theme="light"] {
      --bg-void: #F5F3EF;
      --bg-card: #FFFFFF;
      --bg-card-subtle: #EDEAE4;
      --bg-card-hover: #E4E0D6;
      --border-film: rgba(230, 95, 13, 0.25);
      --border-subtle: rgba(0, 0, 0, 0.1);
      --cinema-cream: #1A1624;
      --cinema-muted: #534E62;
      --shadow-cinema: 0 10px 30px rgba(0, 0, 0, 0.08);
    }

    /* High-Contrast Mode */
    body.high-contrast {
      --bg-void: #000000 !important;
      --bg-card: #0A0A0A !important;
      --bg-card-subtle: #141414 !important;
      --border-subtle: #FFFFFF !important;
      --border-film: #FFFF00 !important;
      --cinema-cream: #FFFFFF !important;
      --cinema-muted: #E0E0E0 !important;
      --cinema-orange: #FFB300 !important;
      --cinema-teal: #00FFFF !important;
      --cinema-gold: #FFFF00 !important;
    }

    /* Text Size Controls */
    body[data-text-size="small"] { --base-font-size: 14px; }
    body[data-text-size="normal"] { --base-font-size: 16px; }
    body[data-text-size="large"] { --base-font-size: 19px; }

    /* Calm Mode */
    body.calm-mode * {
      animation: none !important;
      transition: none !important;
      background-image: none !important;
    }
    body.calm-mode .letterbox-bar { display: none !important; }

    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-void);
      color: var(--cinema-cream);
      font-family: var(--font-body);
      font-size: var(--base-font-size);
      line-height: 1.6;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      position: relative;
    }

    /* Subtle Film Grain */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      background-image: radial-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 0);
      background-size: 28px 28px;
      pointer-events: none;
      z-index: 1;
    }

    /* Theatrical Letterbox Curtains */
    .letterbox-bar {
      position: fixed;
      left: 0;
      width: 100%;
      height: 44px;
      background: #000000;
      z-index: 99999;
      pointer-events: none;
      transition: transform 1.1s cubic-bezier(0.77, 0, 0.175, 1);
    }
    .letterbox-top { top: 0; transform: translateY(0); }
    .letterbox-bottom { bottom: 0; transform: translateY(0); }
    body.curtain-opened .letterbox-top { transform: translateY(-100%); }
    body.curtain-opened .letterbox-bottom { transform: translateY(100%); }

    /* Privacy Mode Blur Shield */
    body.amounts-blurred .money-val,
    body.amounts-blurred [data-blur="amount"] {
      filter: blur(9px) !important;
      user-select: none !important;
      transition: filter 0.2s ease;
    }
    body.amounts-blurred .money-val:hover,
    body.amounts-blurred [data-blur="amount"]:hover {
      filter: blur(0px) !important;
      cursor: help;
    }

    /* Headlines & Body Line Length */
    h1, h2, h3, h4, .headline {
      font-family: var(--font-headline);
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 700;
      line-height: 1.2;
    }
    p, span, label {
      max-width: 75ch;
    }
    .font-mono {
      font-family: var(--font-mono);
      font-variant-numeric: tabular-nums;
    }

    /* Accessible Tap Buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      min-height: var(--tap-target);
      min-width: var(--tap-target);
      padding: 10px 22px;
      font-family: var(--font-headline);
      font-size: 14px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      font-weight: 600;
      border-radius: var(--radius-sm);
      border: 1px solid transparent;
      cursor: pointer;
      transition: var(--transition-smooth);
      text-decoration: none;
      user-select: none;
      position: relative;
    }
    .btn:focus-visible {
      outline: 3px solid var(--border-focus);
      outline-offset: 3px;
    }
    .btn-orange {
      background: linear-gradient(135deg, #FF8A3D 0%, #E66817 100%);
      color: #07060D;
      box-shadow: 0 4px 18px rgba(255, 138, 61, 0.4);
    }
    .btn-orange:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(255, 138, 61, 0.6);
      color: #000;
    }
    .btn-teal {
      background: linear-gradient(135deg, #2DD4BF 0%, #0F9F8E 100%);
      color: #07060D;
      box-shadow: 0 4px 18px rgba(45, 212, 191, 0.35);
    }
    .btn-teal:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 24px rgba(45, 212, 191, 0.55);
    }
    .btn-glass {
      background: rgba(255, 255, 255, 0.05);
      border: 1px solid var(--border-subtle);
      color: var(--cinema-cream);
    }
    .btn-glass:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: var(--cinema-orange);
      transform: translateY(-2px);
    }
    .btn-danger {
      background: rgba(244, 63, 94, 0.15);
      border: 1px solid var(--cinema-crimson);
      color: var(--cinema-crimson);
    }

    /* Cards & Containers */
    .card {
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-md);
      padding: 24px;
      box-shadow: var(--shadow-cinema);
      position: relative;
      overflow: hidden;
      transition: var(--transition-smooth);
    }
    .card:hover {
      border-color: rgba(255, 138, 61, 0.3);
    }
    .card-glow-orange::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--cinema-orange), transparent);
    }
    .card-glow-teal::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--cinema-teal), transparent);
    }
    .card-glow-gold::before {
      content: "";
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: linear-gradient(90deg, transparent, var(--cinema-gold), transparent);
    }

    /* Badges */
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 5px 12px;
      border-radius: var(--radius-pill);
      font-size: 11px;
      font-family: var(--font-headline);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      font-weight: 600;
    }
    .badge-orange { background: rgba(255, 138, 61, 0.15); color: var(--cinema-orange); border: 1px solid rgba(255, 138, 61, 0.35); }
    .badge-teal { background: rgba(45, 212, 191, 0.15); color: var(--cinema-teal); border: 1px solid rgba(45, 212, 191, 0.35); }
    .badge-gold { background: rgba(244, 201, 93, 0.15); color: var(--cinema-gold); border: 1px solid rgba(244, 201, 93, 0.35); }
    .badge-crimson { background: rgba(244, 63, 94, 0.15); color: var(--cinema-crimson); border: 1px solid rgba(244, 63, 94, 0.35); }

    /* Tooltip Question Buttons (?) */
    .help-tooltip-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      width: 20px;
      height: 20px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.1);
      border: 1px solid var(--border-subtle);
      color: var(--cinema-orange);
      font-size: 11px;
      font-weight: 700;
      cursor: pointer;
      margin-left: 5px;
      vertical-align: middle;
    }
    .help-tooltip-btn:hover {
      background: var(--cinema-orange);
      color: #000;
    }

    /* Tables */
    .table-container {
      width: 100%;
      overflow-x: auto;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border-subtle);
    }
    table {
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    th {
      background: var(--bg-card-subtle);
      font-family: var(--font-headline);
      font-size: 12px;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      color: var(--cinema-muted);
      padding: 14px 18px;
      border-bottom: 1px solid var(--border-subtle);
    }
    td {
      padding: 14px 18px;
      border-bottom: 1px solid var(--border-subtle);
      font-size: 14px;
      color: var(--cinema-cream);
    }
    tr:last-child td { border-bottom: none; }
    tr:hover td { background: rgba(255, 255, 255, 0.02); }

    /* Grids */
    .grid-2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; }
    .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
    @media (max-width: 1024px) {
      .grid-4, .grid-3 { grid-template-columns: repeat(2, 1fr); }
    }
    @media (max-width: 768px) {
      .grid-4, .grid-3, .grid-2 { grid-template-columns: 1fr; }
    }

    /* Forms */
    .form-group {
      margin-bottom: 16px;
      text-align: left;
    }
    .form-label {
      display: block;
      font-family: var(--font-headline);
      font-size: 12px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--cinema-muted);
      margin-bottom: 6px;
    }
    .form-control {
      width: 100%;
      min-height: var(--tap-target);
      background: var(--bg-card-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--cinema-cream);
      padding: 10px 14px;
      border-radius: var(--radius-sm);
      font-family: var(--font-body);
      font-size: 15px;
      transition: var(--transition-smooth);
    }
    .form-control:focus {
      outline: none;
      border-color: var(--cinema-orange);
      box-shadow: 0 0 12px rgba(255, 138, 61, 0.25);
    }

    /* Toast & 10-Second Undo */
    #toast-container {
      position: fixed;
      top: 24px;
      right: 24px;
      z-index: 100000;
      display: flex;
      flex-direction: column;
      gap: 12px;
      pointer-events: none;
    }
    .toast {
      pointer-events: auto;
      min-width: 300px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-left: 4px solid var(--cinema-orange);
      padding: 14px 18px;
      border-radius: var(--radius-sm);
      box-shadow: 0 12px 35px rgba(0, 0, 0, 0.8);
      font-size: 14px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      animation: toastSlide 0.3s ease forwards;
    }
    .toast.success { border-left-color: var(--cinema-teal); }
    .toast.error { border-left-color: var(--cinema-crimson); }
    .toast-undo-btn {
      background: var(--cinema-orange);
      color: #000;
      border: none;
      padding: 4px 10px;
      border-radius: 4px;
      font-weight: 700;
      cursor: pointer;
      font-size: 12px;
    }
    @keyframes toastSlide {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    /* Modals */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.85);
      backdrop-filter: blur(8px);
      z-index: 10000;
      display: none;
      align-items: center;
      justify-content: center;
      padding: 16px;
    }
    .modal-overlay.active { display: flex; }
    .modal-dialog {
      background: var(--bg-card);
      border: 1px solid var(--border-film);
      border-radius: var(--radius-md);
      width: 100%;
      max-width: 680px;
      max-height: 90vh;
      overflow-y: auto;
      box-shadow: 0 25px 60px rgba(0, 0, 0, 0.9);
      position: relative;
      animation: modalZoom 0.28s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
    @keyframes modalZoom {
      from { transform: scale(0.92); opacity: 0; }
      to { transform: scale(1); opacity: 1; }
    }
    .modal-header {
      padding: 18px 24px;
      border-bottom: 1px solid var(--border-subtle);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }
    .modal-title { font-size: 18px; color: var(--cinema-cream); }
    .modal-close {
      background: none;
      border: none;
      color: var(--cinema-muted);
      font-size: 24px;
      cursor: pointer;
      width: 44px;
      height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .modal-close:hover { color: var(--cinema-orange); }
    .modal-body { padding: 24px; }
    .modal-footer {
      padding: 16px 24px;
      border-top: 1px solid var(--border-subtle);
      display: flex;
      justify-content: flex-end;
      gap: 12px;
    }

    /* Easy Mode Big 4 Action Tiles */
    .easy-mode-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
      margin: 30px 0;
    }
    @media (max-width: 640px) {
      .easy-mode-grid { grid-template-columns: 1fr; }
    }
    .easy-tile {
      background: var(--bg-card);
      border: 2px solid var(--border-subtle);
      border-radius: var(--radius-lg);
      padding: 32px 24px;
      text-align: center;
      cursor: pointer;
      transition: var(--transition-smooth);
      min-height: 180px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 12px;
    }
    .easy-tile:hover {
      transform: translateY(-4px);
      border-color: var(--cinema-orange);
      box-shadow: 0 10px 30px rgba(255, 138, 61, 0.2);
    }
    .easy-tile-icon { font-size: 48px; }
    .easy-tile-title { font-size: 22px; font-weight: 700; color: var(--cinema-cream); }
    .easy-tile-desc { font-size: 13px; color: var(--cinema-muted); }

    /* Guided Wizard */
    .wizard-progress-bar {
      height: 6px;
      background: rgba(255, 255, 255, 0.1);
      border-radius: 3px;
      margin-bottom: 24px;
      overflow: hidden;
    }
    .wizard-progress-fill {
      height: 100%;
      background: var(--cinema-orange);
      transition: width 0.3s ease;
    }

    /* Language Selection Banner / Buttons */
    .lang-btn-strip {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      justify-content: center;
      margin: 20px 0;
    }
    .lang-pill-btn {
      padding: 8px 16px;
      border-radius: var(--radius-pill);
      background: var(--bg-card-subtle);
      border: 1px solid var(--border-subtle);
      color: var(--cinema-cream);
      font-size: 13px;
      cursor: pointer;
      min-height: var(--tap-target);
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .lang-pill-btn.active, .lang-pill-btn:hover {
      background: var(--cinema-orange);
      color: #000;
      border-color: var(--cinema-orange);
      font-weight: 700;
    }

    /* RTL */
    [dir="rtl"] { text-align: right; }
    [dir="rtl"] #sidebar-dock { border-right: none; border-left: 1px solid var(--border-subtle); }
    [dir="rtl"] .nav-item.active { border-left: none; border-right: 3px solid var(--cinema-orange); }

    /* =========================================================================
       2. TOP BAR & APP NAVIGATION
       ========================================================================= */
    #topbar {
      position: sticky;
      top: 0;
      z-index: 999;
      background: rgba(7, 6, 13, 0.92);
      backdrop-filter: blur(12px);
      border-bottom: 1px solid var(--border-subtle);
      min-height: 64px;
      padding: 0 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 10px;
    }
    .brand-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
      cursor: pointer;
    }
    .brand-reel-icon {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, var(--cinema-orange), #C2410C);
      border-radius: 8px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: #000;
      font-weight: 900;
      font-family: var(--font-headline);
      box-shadow: 0 0 15px var(--cinema-orange-glow);
    }
    .brand-name { font-family: var(--font-headline); font-size: 22px; letter-spacing: 0.1em; color: var(--cinema-cream); }

    .topbar-controls {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-wrap: wrap;
    }

    /* Mode Switch Toggle: Easy vs Pro */
    .mode-switch-container {
      display: flex;
      background: var(--bg-card-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-pill);
      padding: 2px;
    }
    .mode-btn {
      padding: 6px 14px;
      font-size: 12px;
      font-family: var(--font-headline);
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border: none;
      background: none;
      color: var(--cinema-muted);
      border-radius: var(--radius-pill);
      cursor: pointer;
      min-height: 32px;
    }
    .mode-btn.active {
      background: var(--cinema-orange);
      color: #000;
      font-weight: 700;
    }

    /* Accessibility Bar */
    .a11y-pill-group {
      display: flex;
      align-items: center;
      background: var(--bg-card-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      overflow: hidden;
    }
    .a11y-btn {
      background: none;
      border: none;
      color: var(--cinema-cream);
      padding: 6px 10px;
      font-size: 12px;
      cursor: pointer;
      min-height: 32px;
    }
    .a11y-btn:hover { background: rgba(255, 255, 255, 0.1); }

    /* =========================================================================
       3. LANDING PAGE & MOVIE HERO
       ========================================================================= */
    #view-landing {
      flex: 1;
      display: flex;
      flex-direction: column;
      position: relative;
    }
    .hero-section {
      min-height: 80vh;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 60px 20px;
      background: radial-gradient(circle at 50% 25%, rgba(255, 138, 61, 0.15) 0%, transparent 65%);
    }
    .hero-title {
      font-size: clamp(48px, 9vw, 92px);
      letter-spacing: 0.14em;
      color: var(--cinema-cream);
      text-shadow: 0 0 50px rgba(255, 138, 61, 0.4);
      margin-bottom: 16px;
    }

    /* Film Strip Reel */
    .film-strip-section {
      padding: 50px 0;
      background: #050409;
      border-top: 1px solid var(--border-subtle);
      border-bottom: 1px solid var(--border-subtle);
    }
    .film-sprocket-row {
      height: 18px;
      background-image: repeating-linear-gradient(90deg, #1A162B 0px, #1A162B 14px, transparent 14px, transparent 28px);
      margin: 0 auto 24px auto;
      width: 95%;
    }
    .reel-slider {
      display: flex;
      gap: 20px;
      overflow-x: auto;
      padding: 0 30px 16px 30px;
      scrollbar-width: none;
    }
    .reel-slider::-webkit-scrollbar { display: none; }
    .reel-frame {
      flex: 0 0 300px;
      background: var(--bg-card);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      padding: 20px;
      transition: var(--transition-smooth);
    }
    .reel-frame:hover { border-color: var(--cinema-orange); transform: translateY(-3px); }

    /* =========================================================================
       4. APP SHELL DOCK & VIEWS
       ========================================================================= */
    #app-container {
      display: none;
      flex: 1;
      height: calc(100vh - 64px);
      overflow: hidden;
    }
    body.in-portal #view-landing { display: none; }
    body.in-portal #app-container { display: flex; }

    #sidebar-dock {
      width: 250px;
      background: #06050C;
      border-right: 1px solid var(--border-subtle);
      display: flex;
      flex-direction: column;
      padding: 16px 10px;
      gap: 4px;
      overflow-y: auto;
      flex-shrink: 0;
    }
    @media (max-width: 768px) {
      #app-container { flex-direction: column; height: auto; }
      #sidebar-dock {
        width: 100%;
        height: auto;
        flex-direction: row;
        overflow-x: auto;
        border-right: none;
        border-bottom: 1px solid var(--border-subtle);
        padding: 8px;
      }
      .nav-item { white-space: nowrap; }
      .nav-category { display: none; }
    }
    .nav-item {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 9px 14px;
      border-radius: var(--radius-sm);
      color: var(--cinema-muted);
      text-decoration: none;
      font-family: var(--font-headline);
      font-size: 13px;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      cursor: pointer;
      min-height: var(--tap-target);
      transition: var(--transition-smooth);
    }
    .nav-item:hover { background: rgba(255, 255, 255, 0.04); color: var(--cinema-cream); }
    .nav-item.active {
      background: rgba(255, 138, 61, 0.14);
      color: var(--cinema-orange);
      border-left: 3px solid var(--cinema-orange);
    }
    .nav-category {
      font-size: 10px;
      color: rgba(255, 255, 255, 0.35);
      padding: 10px 14px 4px 14px;
      font-family: var(--font-mono);
      letter-spacing: 0.1em;
    }

    #main-content {
      flex: 1;
      overflow-y: auto;
      padding: 24px;
      background: var(--bg-void);
    }
    .view-pane { display: none; animation: fadeIn 0.25s ease forwards; }
    .view-pane.active { display: block; }
    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* =========================================================================
       5. SIGNATURE & SPECIALTY COMPONENTS
       ========================================================================= */
    /* Movie Theater */
    #movie-theater {
      background: #020204;
      border: 1px solid var(--border-film);
      border-radius: var(--radius-lg);
      padding: 28px;
      min-height: 440px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      box-shadow: 0 0 50px rgba(0, 0, 0, 0.9);
    }
    .movie-scene { display: none; text-align: center; }
    .movie-scene.active { display: block; }

    /* Coin Vault Jars */
    .coin-vault-container {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      margin: 24px 0;
    }
    @media (max-width: 640px) {
      .coin-vault-container { grid-template-columns: repeat(2, 1fr); }
    }
    .glass-jar {
      background: rgba(255, 255, 255, 0.02);
      border: 2px solid rgba(255, 255, 255, 0.12);
      border-radius: var(--radius-md) var(--radius-md) 16px 16px;
      height: 220px;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      overflow: hidden;
      padding: 10px;
      text-align: center;
    }
    .jar-fill {
      position: absolute;
      bottom: 0; left: 0; right: 0;
      background: linear-gradient(180deg, rgba(244, 201, 93, 0.7) 0%, rgba(255, 138, 61, 0.9) 100%);
      transition: height 0.8s cubic-bezier(0.16, 1, 0.3, 1);
    }
    .jar-label { position: relative; z-index: 2; font-family: var(--font-headline); font-size: 13px; }

    /* QR Scanner Card (Matching User Screenshot) */
    .qr-scanner-card {
      background: #0A0B14;
      border: 2px solid var(--cinema-teal);
      border-radius: var(--radius-lg);
      padding: 24px;
      max-width: 440px;
      margin: 0 auto;
      text-align: center;
      box-shadow: 0 0 35px var(--cinema-teal-glow);
    }
    .qr-camera-viewport {
      width: 100%;
      height: 250px;
      background: #04050A;
      border: 1px solid rgba(45, 212, 191, 0.3);
      border-radius: var(--radius-md);
      position: relative;
      overflow: hidden;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      margin-bottom: 18px;
    }
    .qr-scanline {
      position: absolute;
      top: 0; left: 0; right: 0;
      height: 3px;
      background: var(--cinema-teal);
      box-shadow: 0 0 15px 3px var(--cinema-teal);
      animation: scanSweep 2s ease-in-out infinite alternate;
    }
    @keyframes scanSweep {
      from { top: 5%; }
      to { top: 95%; }
    }

    /* Film Credits Tour */
    #credits-tour-overlay {
      position: fixed;
      inset: 0;
      background: #000000;
      z-index: 100001;
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 30px;
    }
    .tour-content { max-width: 600px; animation: tourFloat 0.5s ease forwards; }
    @keyframes tourFloat {
      from { transform: translateY(20px); opacity: 0; }
      to { transform: translateY(0); opacity: 1; }
    }

    /* =========================================================================
       CA BUDDY CINEMATIC STYLES & FINANCIAL CHIPS
       ========================================================================= */
    .ca-steps-nav {
      display: flex;
      justify-content: space-between;
      margin-bottom: 24px;
      position: relative;
      background: var(--bg-card-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-pill);
      padding: 6px;
      overflow-x: auto;
    }
    .ca-step-item {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 18px;
      border-radius: var(--radius-pill);
      color: var(--cinema-muted);
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      white-space: nowrap;
      transition: var(--transition-smooth);
    }
    .ca-step-item.active {
      background: var(--cinema-orange);
      color: #07060D;
      font-weight: 700;
      box-shadow: 0 0 15px var(--cinema-orange-glow);
    }
    .ca-step-item.completed {
      color: var(--cinema-teal);
    }
    .ca-step-badge {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      background: rgba(255,255,255,0.12);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 11px;
    }
    .ca-step-item.active .ca-step-badge {
      background: #07060D;
      color: var(--cinema-orange);
      font-weight: 800;
    }

    .ca-dropzone {
      border: 2px dashed rgba(255, 138, 61, 0.4);
      background: radial-gradient(circle at center, rgba(255, 138, 61, 0.05) 0%, transparent 70%), var(--bg-card);
      border-radius: var(--radius-lg);
      padding: 40px 24px;
      text-align: center;
      cursor: pointer;
      transition: var(--transition-smooth);
      position: relative;
    }
    .ca-dropzone:hover, .ca-dropzone.dragover {
      border-color: var(--cinema-orange);
      box-shadow: 0 0 30px var(--cinema-orange-glow);
      transform: translateY(-2px);
    }

    /* Category Chips (23 Specific Categories) */
    .cat-chip {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: var(--radius-pill);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.02em;
      cursor: pointer;
      transition: var(--transition-smooth);
      border: 1px solid transparent;
      user-select: none;
    }
    .cat-chip:hover {
      filter: brightness(1.2);
      transform: scale(1.04);
    }
    .cat-salary { background: rgba(45,212,191,0.15); color: #2DD4BF; border-color: rgba(45,212,191,0.3); }
    .cat-business { background: rgba(16,185,129,0.15); color: #10B981; border-color: rgba(16,185,129,0.3); }
    .cat-freelance { background: rgba(6,182,212,0.15); color: #06B6D4; border-color: rgba(6,182,212,0.3); }
    .cat-interest { background: rgba(132,204,22,0.15); color: #84CC16; border-color: rgba(132,204,22,0.3); }
    .cat-rent { background: rgba(245,158,11,0.15); color: #F59E0B; border-color: rgba(245,158,11,0.3); }
    .cat-utilities { background: rgba(255,138,61,0.15); color: #FF8A3D; border-color: rgba(255,138,61,0.3); }
    .cat-groceries { background: rgba(34,197,94,0.15); color: #22C55E; border-color: rgba(34,197,94,0.3); }
    .cat-fuel { background: rgba(234,179,8,0.15); color: #EAB308; border-color: rgba(234,179,8,0.3); }
    .cat-travel { background: rgba(14,165,233,0.15); color: #0EA5E9; border-color: rgba(14,165,233,0.3); }
    .cat-food { background: rgba(249,115,22,0.15); color: #F97316; border-color: rgba(249,115,22,0.3); }
    .cat-shopping { background: rgba(236,72,153,0.15); color: #EC4899; border-color: rgba(236,72,153,0.3); }
    .cat-emi { background: rgba(239,68,68,0.15); color: #EF4444; border-color: rgba(239,68,68,0.3); }
    .cat-insurance { background: rgba(168,85,247,0.15); color: #A855F7; border-color: rgba(168,85,247,0.3); }
    .cat-investment { background: rgba(244,201,93,0.15); color: #F4C95D; border-color: rgba(244,201,93,0.3); }
    .cat-tax { background: rgba(220,38,38,0.15); color: #DC2626; border-color: rgba(220,38,38,0.3); }
    .cat-gst { background: rgba(225,29,72,0.15); color: #E11D48; border-color: rgba(225,29,72,0.3); }
    .cat-vendor { background: rgba(217,119,6,0.15); color: #D97706; border-color: rgba(217,119,6,0.3); }
    .cat-staff { background: rgba(59,130,246,0.15); color: #3B82F6; border-color: rgba(59,130,246,0.3); }
    .cat-subscription { background: rgba(99,102,241,0.15); color: #6366F1; border-color: rgba(99,102,241,0.3); }
    .cat-cash { background: rgba(148,163,184,0.15); color: #94A3B8; border-color: rgba(148,163,184,0.3); }
    .cat-refund { background: rgba(52,211,153,0.15); color: #34D399; border-color: rgba(52,211,153,0.3); }
    .cat-transfer { background: rgba(192,132,252,0.15); color: #C084FC; border-color: rgba(192,132,252,0.3); }
    .cat-other { background: rgba(100,116,139,0.15); color: #94A3B8; border-color: rgba(100,116,139,0.3); }

    .ca-subtabs {
      display: flex;
      gap: 8px;
      margin-bottom: 20px;
      overflow-x: auto;
      border-bottom: 1px solid var(--border-subtle);
      padding-bottom: 8px;
    }
    .ca-subtab-btn {
      padding: 8px 16px;
      background: var(--bg-card-subtle);
      border: 1px solid var(--border-subtle);
      border-radius: var(--radius-sm);
      color: var(--cinema-muted);
      cursor: pointer;
      font-size: 13px;
      font-weight: 600;
      white-space: nowrap;
      transition: var(--transition-smooth);
    }
    .ca-subtab-btn.active {
      background: var(--cinema-orange);
      color: #07060D;
      font-weight: 700;
      border-color: var(--cinema-orange);
      box-shadow: 0 0 15px var(--cinema-orange-glow);
    }

    .mic-recording-pulse {
      animation: micPulse 1.2s infinite;
      background: var(--cinema-crimson) !important;
      color: #fff !important;
    }
    @keyframes micPulse {
      0% { transform: scale(1); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0.7); }
      70% { transform: scale(1.08); box-shadow: 0 0 0 12px rgba(244, 63, 94, 0); }
      100% { transform: scale(1); box-shadow: 0 0 0 0 rgba(244, 63, 94, 0); }
    }
  </style>
</head>
<body class="curtain-opened" data-text-size="normal">

  <!-- Theatrical Letterbox Bars -->
  <div class="letterbox-bar letterbox-top"></div>
  <div class="letterbox-bar letterbox-bottom"></div>

  <!-- Toast Notification Hub with 10-Second Undo -->
  <div id="toast-container" aria-live="polite"></div>

  <!-- =========================================================================
       TOPBAR & UNIVERSAL ACCESSIBILITY CONTROLS
       ========================================================================= -->
  <header id="topbar">
    <div class="brand-logo" onclick="navigateTo('landing')">
      <div class="brand-reel-icon">P</div>
      <span class="brand-name">PAYPILOT</span>
      <span class="badge badge-orange" style="margin-left: 6px;">ENTERPRISE</span>
    </div>

    <!-- Mode Switcher: Easy Mode vs Pro Mode -->
    <div class="mode-switch-container" role="radiogroup" aria-label="Interface Complexity Mode">
      <button class="mode-btn active" id="btn-mode-easy" onclick="setInterfaceMode('easy')">✨ Easy Mode</button>
      <button class="mode-btn" id="btn-mode-pro" onclick="setInterfaceMode('pro')">⚡ Pro Mode</button>
    </div>

    <div class="topbar-controls">
      <!-- Read Aloud / Speak This Page -->
      <button class="btn btn-glass" onclick="speakCurrentView()" title="Read aloud this screen">
        <span>🔊 Speak</span>
      </button>

      <!-- Privacy Shield: Hide Amounts Eye Toggle -->
      <button class="btn btn-glass" id="btn-toggle-blur" onclick="toggleAmountBlur()" title="Hide Amounts (Privacy Mode)">
        <span id="eye-icon">👁️</span>
      </button>

      <!-- Text Size Scaling -->
      <div class="a11y-pill-group" title="Adjust Text Size">
        <button class="a11y-btn" onclick="setTextSize('small')">A-</button>
        <button class="a11y-btn" onclick="setTextSize('normal')">A</button>
        <button class="a11y-btn" onclick="setTextSize('large')">A+</button>
      </div>

      <!-- High Contrast Toggle -->
      <button class="btn btn-glass" onclick="toggleHighContrast()" title="Toggle High Contrast">
        <span>👁️‍🗨️</span>
      </button>

      <!-- Calm Mode Toggle -->
      <button class="btn btn-glass" onclick="toggleCalmMode()" title="Toggle Calm Mode (Disable animations)">
        <span>🕊️</span>
      </button>

      <!-- Language Selector -->
      <select class="form-control" style="width: auto; min-height: 36px; padding: 4px 8px; font-size: 13px;" id="lang-select" onchange="changeLanguage(this.value)">
        <option value="en">English</option>
        <option value="hi">हिन्दी (Hindi)</option>
        <option value="pa">ਪੰਜਾਬੀ (Punjabi)</option>
        <option value="ur">اردو (Urdu)</option>
        <option value="ta">தமிழ் (Tamil)</option>
        <option value="te">తెలుగు (Telugu)</option>
        <option value="bn">বাংলা (Bengali)</option>
        <option value="mr">मराठी (Marathi)</option>
        <option value="gu">ગુજરાતી (Gujarati)</option>
      </select>

      <!-- First-Visit Tour / Help Button -->
      <button class="btn btn-glass" onclick="startTour()" title="Play 20-second film credits tour">
        <span>❓ Tour</span>
      </button>

      <!-- Command Palette Ctrl+K Trigger -->
      <button class="btn btn-glass" onclick="openCommandPalette()" title="Press Ctrl+K">
        <span>Ctrl+K</span>
      </button>

      <!-- CA Buddy Direct Launcher -->
      <button class="btn btn-orange" onclick="openCaBuddy()" title="CA Buddy - AI Chartered Accountant from Bank Statement" style="min-height: 34px; padding: 4px 14px; font-size: 12px; font-weight: 700;">
        <span>💼 CA Buddy</span>
      </button>

      <!-- Auth State / Enter Portal -->
      <div id="user-profile-chip" style="display: none; align-items: center; gap: 10px;">
        <div style="display: flex; align-items: center; gap: 8px; background: rgba(255,255,255,0.06); padding: 4px 10px; border-radius: 20px; border: 1px solid var(--border-subtle);">
          <div id="chip-user-avatar" style="width: 24px; height: 24px; border-radius: 50%; background: var(--cinema-orange); color: #fff; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700;">G</div>
          <div style="line-height: 1.2;">
            <div style="font-size: 12px; font-weight: 700; color: var(--cinema-cream);" id="chip-user-name">Rishu Ranjan</div>
            <div style="font-size: 10px; color: var(--cinema-muted);" id="chip-user-email">rishuranjanrfj@gmail.com</div>
          </div>
          <span class="badge badge-orange" id="chip-user-role" style="font-size: 9px; padding: 2px 6px;">ADMIN</span>
        </div>
        <button class="btn btn-glass" style="min-height: 32px; padding: 4px 10px; font-size: 11px;" onclick="handleGoogleLogout()" title="Secure Logout & Invalidate Session">Sign Out ➔</button>
      </div>
      <button class="btn btn-orange" id="btn-enter-portal" onclick="openLoginModal()">Enter Portal</button>
    </div>
  </header>

  <!-- =========================================================================
       PAGE 1: LANDING PAGE
       ========================================================================= -->
  <main id="view-landing">
    <!-- Big 9-Language Banner -->
    <div style="background: rgba(255, 138, 61, 0.08); border-bottom: 1px solid var(--border-subtle); padding: 12px 20px; text-align: center;">
      <span style="font-size: 12px; color: var(--cinema-muted); margin-right: 12px;">CHOOSE YOUR LANGUAGE / अपनी भाषा चुनें:</span>
      <div class="lang-btn-strip" style="display: inline-flex; margin: 0;">
        <button class="lang-pill-btn active" onclick="changeLanguage('en')">English</button>
        <button class="lang-pill-btn" onclick="changeLanguage('hi')">हिन्दी</button>
        <button class="lang-pill-btn" onclick="changeLanguage('pa')">ਪੰਜਾਬੀ</button>
        <button class="lang-pill-btn" onclick="changeLanguage('ur')">اردو</button>
        <button class="lang-pill-btn" onclick="changeLanguage('ta')">தமிழ்</button>
        <button class="lang-pill-btn" onclick="changeLanguage('te')">తెలుగు</button>
        <button class="lang-pill-btn" onclick="changeLanguage('bn')">বাংলা</button>
        <button class="lang-pill-btn" onclick="changeLanguage('mr')">मराठी</button>
        <button class="lang-pill-btn" onclick="changeLanguage('gu')">ગુજરાતી</button>
      </div>
    </div>

    <!-- Theatrical Hero -->
    <section class="hero-section">
      <span class="badge badge-orange" style="margin-bottom: 14px;">RISHU RANJAN • CINEMATIC FINTECH FOR EVERYONE</span>
      <h1 class="hero-title">PAYPILOT</h1>
      <p style="font-size: clamp(16px, 2.2vw, 22px); color: var(--cinema-muted); margin-bottom: 30px;">
        Clear, honest payroll and tax intelligence. Built for shop owners, grandparents, and enterprise teams alike.
      </p>

      <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; margin-bottom: 40px;">
        <button class="btn btn-orange" onclick="openLoginModal()" style="padding: 14px 34px; font-size: 16px;">
          🚀 Enter The Portal
        </button>
        <button class="btn btn-glass" onclick="startTour()" style="padding: 14px 28px; font-size: 16px;">
          🎬 See The 20-Sec Tour
        </button>
      </div>

      <!-- Live Tax CTC Slider -->
      <div class="card card-glow-orange" style="max-width: 900px; width: 100%; text-align: left; margin: 0 auto;">
        <div style="display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap;">
          <div>
            <h3 style="color: var(--cinema-cream);">Live Tax Engine (Union Budget 2025)</h3>
            <span style="font-size: 12px; color: var(--cinema-muted);">Slide your annual package to test the statutory winner</span>
          </div>
          <div class="font-mono" style="font-size: 28px; font-weight: 700; color: var(--cinema-orange);" id="landing-ctc-val">₹15,00,000</div>
        </div>

        <input type="range" min="300000" max="3000000" step="25000" value="1500000" style="width: 100%; height: 8px; margin: 20px 0; accent-color: var(--cinema-orange); cursor: pointer;" oninput="updateLandingTaxDemo(this.value)">

        <div class="grid-2">
          <div style="background: var(--bg-card-subtle); padding: 16px; border-radius: var(--radius-sm);">
            <div style="display: flex; justify-content: space-between;">
              <strong>Old Regime Tax:</strong>
              <span class="font-mono money-val" style="color: var(--cinema-gold); font-size: 18px;" id="landing-old-tax">₹2,02,800</span>
            </div>
            <div style="font-size: 12px; color: var(--cinema-muted); margin-top: 4px;">With ₹50k std + ₹1.5L (80C) + ₹25k (80D)</div>
          </div>
          <div style="background: var(--bg-card-subtle); padding: 16px; border-radius: var(--radius-sm);">
            <div style="display: flex; justify-content: space-between;">
              <strong>New Regime Tax (Sec 115BAC):</strong>
              <span class="font-mono money-val" style="color: var(--cinema-teal); font-size: 18px;" id="landing-new-tax">₹97,500</span>
            </div>
            <div style="font-size: 12px; color: var(--cinema-muted); margin-top: 4px;">With ₹75k std + Sec 87A rebate up to ₹12L</div>
          </div>
        </div>

        <div id="landing-winner-badge" style="margin-top: 18px; padding: 12px; background: rgba(45, 212, 191, 0.12); border: 1px solid var(--cinema-teal); border-radius: var(--radius-sm); color: var(--cinema-teal); font-weight: 700; text-align: center;">
          🎯 NEW REGIME WINS: Saves ₹1,05,300 in annual take-home!
        </div>
      </div>
    
      <!-- VIEW: PAYSLIP TIMELINE -->
      <div id="pane-payslip-timeline" class="view-pane"></div>

      <!-- VIEW: TAX CHECKLIST -->
      <div id="pane-tax-checklist" class="view-pane"></div>

      <!-- VIEW: CASH CALENDAR -->
      <div id="pane-cashflow-cal" class="view-pane"></div>

    </section>

    <!-- Film-Strip Feature Reel -->
    <section class="film-strip-section">
      <div class="film-sprocket-row"></div>
      <div class="reel-slider">
        <div class="reel-frame">
          <span class="badge badge-orange" style="margin-bottom: 8px;">REEL 01</span>
