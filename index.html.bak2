                <p style="font-size: 14px; color: var(--cinema-muted); margin: 0;" id="ca-story-tagline">
                  Analysis of 60 transactions across FY 2025-26 • Clean balance sheet &amp; tax posture generated.
                </p>
              </div>
              <div style="text-align: right;">
                <div style="font-size: 11px; color: var(--cinema-muted); text-transform: uppercase;">Financial Health Score</div>
                <div class="font-mono" style="font-size: 38px; font-weight: 800; color: var(--cinema-teal);" id="ca-health-score-val">88/100</div>
                <span class="badge badge-teal">Tier A Statutory Sound</span>
              </div>
            </div>

            <!-- Quick 5 KPI Strip -->
            <div class="grid-4" style="margin-top: 20px;">
              <div style="background: var(--bg-card-subtle); padding: 14px; border-radius: var(--radius-sm);">
                <div style="font-size: 11px; color: var(--cinema-muted);">Total Verified Income</div>
                <div class="font-mono money-val" style="font-size: 22px; font-weight: 700; color: var(--cinema-teal);" id="ca-kpi-income">₹0</div>
              </div>
              <div style="background: var(--bg-card-subtle); padding: 14px; border-radius: var(--radius-sm);">
                <div style="font-size: 11px; color: var(--cinema-muted);">Total Business &amp; Living Expenses</div>
                <div class="font-mono money-val" style="font-size: 22px; font-weight: 700; color: var(--cinema-crimson);" id="ca-kpi-expense">₹0</div>
              </div>
              <div style="background: var(--bg-card-subtle); padding: 14px; border-radius: var(--radius-sm);">
