      <!-- =======================================================================
           VIEW: EMPLOYEES DIRECTORY & NATURAL LANGUAGE SEARCH
           ======================================================================= -->
      <div id="pane-employees" class="view-pane">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap;">
          <div>
            <h2>PERSONNEL DIRECTORY</h2>
            <p style="color: var(--cinema-muted);">Manage team, wage rates, and tax regimes.</p>
          </div>
          <button class="btn btn-teal" onclick="openWizard('employee')">+ Add Person</button>
        </div>

        <!-- Smart Natural Language Search Input -->
        <div style="margin-bottom: 20px;">
          <input type="text" class="form-control" id="smart-search-input" placeholder="🔍 Try smart search: 'sales team', 'more than 15 lakh', or 'daily wage'..." oninput="handleSmartSearch(this.value)">
        </div>

        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Code</th>
                <th>Name</th>
                <th>Department</th>
                <th>Role</th>
                <th>Annual CTC</th>
                <th>Regime</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="emp-table-rows">
              <!-- Rendered by JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- =======================================================================
           VIEW: PAYROLL RUNS
           ======================================================================= -->
      <div id="pane-payroll" class="view-pane">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap;">
          <div>
            <h2>MONTHLY PAYROLL RUNS</h2>
            <p style="color: var(--cinema-muted);">Draft, verify, and disburse statutory runs.</p>
          </div>
          <button class="btn btn-orange" onclick="openWizard('payroll')">+ Run New Payroll</button>
        </div>

        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>Run Code</th>
                <th>Month</th>
                <th>Gross Total</th>
                <th>Deductions</th>
                <th>Net Disbursed</th>
                <th>Status</th>
                <th>Actions</th>
              </tr>
            </thead>
            <tbody id="payroll-table-rows">
              <!-- Rendered by JS -->
            </tbody>
          </table>
        </div>
      </div>

      <!-- =======================================================================
           VIEW: TAX CALCULATOR
           ======================================================================= -->
      <div id="pane-tax-calc" class="view-pane">
        <div style="margin-bottom: 20px;">
          <h2>STATUTORY TAX COMPARER (BUDGET 2025)</h2>
          <p style="color: var(--cinema-muted);">Dual regime evaluation with Section 87A rebate &amp; 4% cess.</p>
        </div>

        <div class="grid-2">
          <div class="card">
            <h3 style="color: var(--cinema-orange); margin-bottom: 14px;">Salary &amp; Exemptions</h3>
            <div class="form-group">
              <label class="form-label">Annual Gross CTC (₹)</label>
              <input type="number" class="form-control font-mono" id="pane-tax-gross" value="1500000" oninput="calculatePaneTax()">
            </div>
            <div class="form-group">
              <label class="form-label">Section 80C Claim (₹) <button class="help-tooltip-btn" onclick="explainTerm('80c')">?</button></label>
              <input type="number" class="form-control font-mono" id="pane-tax-80c" value="150000" oninput="calculatePaneTax()">
            </div>
            <div class="form-group">
              <label class="form-label">Section 80D Health Insurance (₹) <button class="help-tooltip-btn" onclick="explainTerm('80d')">?</button></label>
              <input type="number" class="form-control font-mono" id="pane-tax-80d" value="25000" oninput="calculatePaneTax()">
            </div>
            <div class="form-group">
              <label class="form-label">NPS 80CCD(1B) (₹) <button class="help-tooltip-btn" onclick="explainTerm('nps')">?</button></label>
              <input type="number" class="form-control font-mono" id="pane-tax-nps" value="50000" oninput="calculatePaneTax()">
            </div>
          </div>

          <div class="card card-glow-teal">
            <h3 style="color: var(--cinema-teal); margin-bottom: 14px;">Comparative Breakdown</h3>
            <div id="pane-tax-results" style="font-size: 14px; line-height: 1.8;">
              <!-- Calculated via JS -->
            </div>
          </div>
        </div>
      </div>

      <!-- =======================================================================
           VIEW: SALARY JOURNEY (MOVIE MODE)
           ======================================================================= -->
      <div id="pane-salary-journey" class="view-pane">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; flex-wrap: wrap;">
          <div>
            <h2>SALARY JOURNEY // MOVIE MODE</h2>
            <p style="color: var(--cinema-muted);">A 30-second animated story of your financial year.</p>
          </div>
          <select class="form-control" style="width: 220px;" id="journey-emp-select" onchange="restartMovie()">
            <option value="EMP-101">Aarav Sharma</option>
            <option value="EMP-102">Priya Patel</option>
            <option value="EMP-103">Rohan Verma</option>
          </select>
        </div>

        <div id="movie-theater">
          <div style="min-height: 280px; display: flex; align-items: center; justify-content: center;">
            <div class="movie-scene active" id="m-scene-1">
              <span class="badge badge-orange">SCENE 01</span>
              <h1 style="font-size: 40px; margin-top: 10px;">AARAV SHARMA</h1>
              <h3 style="color: var(--cinema-gold);">A YEAR IN PAY</h3>
              <p style="color: var(--cinema-muted); margin-top: 6px;">One salary. Six deductions. One survivor.</p>
            </div>
            <div class="movie-scene" id="m-scene-2">
