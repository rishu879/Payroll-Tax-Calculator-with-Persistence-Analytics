                    <tr><td>Cash Outflow for Operations &amp; Vendors</td><td style="text-align: right; color: var(--cinema-crimson);" class="font-mono money-val" id="ca-cf-ops-out">-₹0</td></tr>
                    <tr style="border-top: 1px solid var(--border-subtle);"><td><strong>Net Cash from Operating Activities (A)</strong></td><td style="text-align: right; font-weight: 700;" class="font-mono money-val" id="ca-cf-net-ops">₹0</td></tr>
                    <tr><td>Cash from / (to) Investments (SIP, PPF, FD) (B)</td><td style="text-align: right; color: var(--cinema-gold);" class="font-mono money-val" id="ca-cf-invest">-₹0</td></tr>
                    <tr><td>Cash from / (to) Financing &amp; EMIs (C)</td><td style="text-align: right; color: var(--cinema-crimson);" class="font-mono money-val" id="ca-cf-finance">-₹0</td></tr>
                    <tr style="border-top: 2px solid var(--border-film);"><td style="font-size: 15px; color: var(--cinema-teal);"><strong>NET SURPLUS CASH INFLOW (A+B+C)</strong></td><td style="text-align: right; font-size: 18px; color: var(--cinema-teal);" class="font-mono money-val" id="ca-cf-total">₹0</td></tr>
                  </tbody>
