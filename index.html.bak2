                    <tr><td>Direct Material &amp; Vendor Purchases</td><td style="text-align: right; color: var(--cinema-crimson);" class="font-mono money-val" id="ca-pnl-vendor-cost">-₹0</td></tr>
                    <tr><td>Staff Wages &amp; Salary Paid</td><td style="text-align: right; color: var(--cinema-crimson);" class="font-mono money-val" id="ca-pnl-wages">-₹0</td></tr>
                    <tr><td>Operating Overheads (Rent, Utilities, Fuel)</td><td style="text-align: right; color: var(--cinema-crimson);" class="font-mono money-val" id="ca-pnl-overheads">-₹0</td></tr>
                    <tr style="border-top: 1px solid var(--border-subtle);"><td style="color: var(--cinema-crimson);"><strong>Total Operating Expenses (B)</strong></td><td style="text-align: right; color: var(--cinema-crimson);" class="font-mono money-val" id="ca-pnl-total-exp">-₹0</td></tr>
                    <tr style="border-top: 2px solid var(--border-film);"><td style="font-size: 15px; color: var(--cinema-orange);"><strong>NET PROFIT / LOSS (A - B)</strong></td><td style="text-align: right; font-size: 18px; color: var(--cinema-orange);" class="font-mono money-val" id="ca-pnl-net">₹0</td></tr>
                  </tbody>
                </table>
                <div style="margin-top: 14px; font-size: 12px; color: var(--cinema-muted);">
