      <!-- =======================================================================
           VIEW: SETTINGS & BACKUP/RESTORE
           ======================================================================= -->
      <div id="pane-settings" class="view-pane">
        <div style="margin-bottom: 20px;">
          <h2>SYSTEM SETTINGS &amp; DATA BACKUP</h2>
          <p style="color: var(--cinema-muted);">Export your data as JSON or restore from a text snippet.</p>
        </div>

        <div class="grid-2">
          <!-- Backup Card -->
          <div class="card">
            <h3 style="color: var(--cinema-teal); margin-bottom: 10px;">Export Backup (JSON)</h3>
            <p style="font-size: 13px; color: var(--cinema-muted); margin-bottom: 12px;">Copy this text to keep a safe backup of your entire company payroll:</p>
            <textarea class="form-control font-mono" id="backup-export-box" rows="5" readonly style="font-size: 11px;"></textarea>
            <button class="btn btn-teal" style="margin-top: 10px;" onclick="copyBackupJson()">📋 Copy JSON Text</button>
          </div>

          <!-- Restore Card -->
          <div class="card">
            <h3 style="color: var(--cinema-orange); margin-bottom: 10px;">Restore From Backup</h3>
            <p style="font-size: 13px; color: var(--cinema-muted); margin-bottom: 12px;">Paste your saved JSON text here to restore state:</p>
            <textarea class="form-control font-mono" id="backup-import-box" rows="5" placeholder="Paste JSON backup here..." style="font-size: 11px;"></textarea>
            <button class="btn btn-orange" style="margin-top: 10px;" onclick="restoreBackupJson()">Restore Data</button>
          </div>
        </div>

        <div class="card" style="margin-top: 24px; border-left: 4px solid var(--cinema-crimson);">
          <h4 style="color: var(--cinema-crimson); margin-bottom: 6px;">Reset Demo Data</h4>
          <p style="font-size: 13px; color: var(--cinema-muted); margin-bottom: 12px;">Restore initial factory demo records across all tables.</p>
          <button class="btn btn-danger" onclick="factoryResetDemo()">Reset To Factory State</button>
        </div>
      </div>

      <!-- =======================================================================
           VIEW: CA BUDDY (AI CHARTERED ACCOUNTANT FROM BANK STATEMENT)
           ======================================================================= -->
      <div id="pane-ca-buddy" class="view-pane">
        <!-- Title Card Header -->
        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 20px; flex-wrap: wrap; gap: 14px;">
          <div>
            <div style="display: flex; align-items: center; gap: 10px;">
              <h2 style="margin: 0; color: var(--cinema-cream); font-family: var(--font-headline); letter-spacing: 0.05em;">💼 CA BUDDY // AI CHARTERED ACCOUNTANT</h2>
              <span class="badge badge-orange">BUDGET 2025</span>
              <span class="badge badge-teal">LOCAL ONLY</span>
            </div>
            <p style="color: var(--cinema-muted); margin-top: 4px; font-size: 14px;">
              Upload your bank statement (PDF, Excel, CSV, or paste text) • Auto-calculates GST, Income Tax, TDS, Advance Tax &amp; P&amp;L with friendly AI answers.
            </p>
          </div>
          <div style="display: flex; gap: 10px; align-items: center;">
            <button class="btn btn-glass" onclick="caClearAllData()" title="Clear current statement and start fresh">🗑️ Clear Statement</button>
            <button class="btn btn-orange" onclick="caLoadSampleStatement()">✨ Try 60-Row Sample</button>
          </div>
        </div>

        <!-- 4-Step Guided Wizard Navigation -->
        <div class="ca-steps-nav">
          <div class="ca-step-item active" id="ca-step-nav-1" onclick="caGoStep(1)">
            <span class="ca-step-badge">1</span>
            <span>Upload Statement</span>
          </div>
          <div class="ca-step-item" id="ca-step-nav-2" onclick="caGoStep(2)">
            <span class="ca-step-badge">2</span>
            <span>Check Columns &amp; Duplicates</span>
          </div>
          <div class="ca-step-item" id="ca-step-nav-3" onclick="caGoStep(3)">
            <span class="ca-step-badge">3</span>
            <span>Review Categories (23 Rules)</span>
          </div>
          <div class="ca-step-item" id="ca-step-nav-4" onclick="caGoStep(4)">
            <span class="ca-step-badge">4</span>
            <span>See Financial Dossier &amp; Reports</span>
          </div>
        </div>

        <!-- STEP 1: UPLOAD & READ -->
        <div id="ca-step-1" class="ca-step-pane">
          <!-- Privacy First Banner -->
          <div class="card card-glow-teal" style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 24px; padding: 14px 20px; flex-wrap: wrap; gap: 12px; border-left: 4px solid var(--cinema-teal);">
            <div style="display: flex; align-items: center; gap: 12px;">
              <span style="font-size: 24px;">🛡️</span>
              <div>
                <strong style="color: var(--cinema-teal);">Your Statement Stays On Your Device</strong>
                <p style="font-size: 12px; color: var(--cinema-muted); margin: 0;">Parsed completely client-side in your browser with PapaParse, SheetJS and PDF.js. No raw statement rows or account numbers are ever sent to any server.</p>
              </div>
            </div>
            <div style="display: flex; gap: 12px; align-items: center;">
              <label style="font-size: 12px; color: var(--cinema-muted); cursor: pointer; display: flex; align-items: center; gap: 6px;">
                <input type="checkbox" id="ca-auto-clear-toggle" checked> Auto-clear on page exit
              </label>
              <button class="btn btn-danger" style="min-height: 32px; padding: 4px 10px; font-size: 11px;" onclick="caClearAllData()">Delete Everything Now</button>
            </div>
          </div>

          <!-- Upload Method Tabs -->
          <div class="card" style="margin-bottom: 24px;">
            <div style="display: flex; gap: 10px; border-bottom: 1px solid var(--border-subtle); padding-bottom: 12px; margin-bottom: 20px; flex-wrap: wrap;">
              <button class="btn btn-glass active" id="ca-tab-btn-file" onclick="caSwitchUploadTab('file')">📁 Upload File (CSV, Excel, PDF)</button>
              <button class="btn btn-glass" id="ca-tab-btn-paste" onclick="caSwitchUploadTab('paste')">📋 Paste Net-Banking Text</button>
              <button class="btn btn-glass" id="ca-tab-btn-sample" onclick="caSwitchUploadTab('sample')">🎬 Load 60-Row Sample Dataset</button>
            </div>

            <!-- Tab 1: File Dropzone -->
            <div id="ca-upload-tab-file">
              <div class="ca-dropzone" id="ca-drop-target" onclick="document.getElementById('ca-file-input').click()">
                <input type="file" id="ca-file-input" accept=".csv, .xlsx, .xls, .pdf" style="display: none;" onchange="caHandleFileSelect(event)">
                <div style="font-size: 48px; margin-bottom: 12px;">📑</div>
                <h3 style="color: var(--cinema-cream); margin-bottom: 8px;">Drag &amp; drop your statement here, or tap to choose file</h3>
                <p style="font-size: 13px; color: var(--cinema-muted); margin-bottom: 16px;">
                  Supports CSV, Excel (.xlsx, .xls) and text-based PDFs downloaded from HDFC, SBI, ICICI, Axis, Kotak, PNB &amp; others.
                </p>
                <button class="btn btn-orange" style="pointer-events: none;">Browse Files</button>
              </div>

              <!-- Friendly Error for Scanned PDFs -->
              <div id="ca-scanned-pdf-alert" style="display: none; margin-top: 16px; padding: 14px; background: rgba(244, 63, 94, 0.1); border: 1px solid var(--cinema-crimson); border-radius: var(--radius-sm); color: var(--cinema-crimson); font-size: 13px;">
                <strong>⚠️ Scanned Document Notice:</strong> This PDF looks like a scanned image or photo without selectable text. For 100% accuracy, please download and upload the CSV or Excel statement directly from your bank's net banking portal, or copy-paste the text lines in the "Paste Text" tab.
              </div>
            </div>

            <!-- Tab 2: Paste Text -->
            <div id="ca-upload-tab-paste" style="display: none;">
              <p style="font-size: 13px; color: var(--cinema-muted); margin-bottom: 10px;">
                Copy lines directly from your bank account transaction table or PDF and paste here:
              </p>
              <textarea class="form-control font-mono" id="ca-paste-textarea" rows="8" placeholder="Date       Narration                                       Debit       Credit      Balance&#10;01/10/2025 SAL/TECHCORP INDIA/OCT25                                     1,75,000.00 2,10,000.00&#10;02/10/2025 UPI/DMART SUPERMARKET/GROCERIES                  4,850.00                2,05,150.00" style="font-size: 12px;"></textarea>
              <button class="btn btn-orange" style="margin-top: 14px;" onclick="caParsePastedText()">Parse Pasted Statement ➔</button>
            </div>

            <!-- Tab 3: Sample Statement Info -->
            <div id="ca-upload-tab-sample" style="display: none;">
              <div style="background: var(--bg-card-subtle); padding: 16px; border-radius: var(--radius-sm); margin-bottom: 16px;">
                <h4 style="color: var(--cinema-gold); margin-bottom: 6px;">Realistic 60-Row Indian Financial Dataset</h4>
                <p style="font-size: 13px; color: var(--cinema-cream); margin-bottom: 10px;">
                  Includes salary credits, freelance transfers (Upwork/US clients), GST payments (PMT-06), Advance Tax (Challan 280), raw material vendor invoices (Sharma Traders, Patel Packaging), utility bills, EMIs, mutual fund SIPs, staff wages, TDS deductions (194J, 194C, 194A), and bank charge money leaks.
                </p>
                <div style="display: flex; gap: 8px; flex-wrap: wrap;">
                  <span class="badge badge-teal">60 Rows</span>
                  <span class="badge badge-orange">All 23 Categories Triggered</span>
                  <span class="badge badge-gold">₹12.5L Turnover</span>
                  <span class="badge badge-teal">Self-Transfers Included</span>
                </div>
              </div>
              <button class="btn btn-orange" onclick="caLoadSampleStatement()">Load Sample Statement Now ➔</button>
            </div>
          </div>
        </div>

        <!-- STEP 2: CHECK & FIX COLUMNS -->
        <div id="ca-step-2" class="ca-step-pane" style="display: none;">
          <div class="card card-glow-orange" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
            <div>
              <span class="badge badge-orange" id="ca-detected-bank-badge">DETECTED BANK: HDFC BANK</span>
              <h3 style="color: var(--cinema-cream); margin: 6px 0 2px 0;">Mapping Check &amp; Deduplication</h3>
              <p style="font-size: 13px; color: var(--cinema-muted); margin: 0;" id="ca-step2-stats">
                Showing first 20 rows • 0 duplicates removed • 0 self-transfers flagged
              </p>
            </div>
            <div style="display: flex; gap: 10px;">
              <button class="btn btn-glass" onclick="caGoStep(1)">Back</button>
              <button class="btn btn-orange" onclick="caGoStep(3)">Proceed to Categorisation ➔</button>
            </div>
          </div>

          <div class="card" style="margin-bottom: 24px; overflow-x: auto;">
            <div style="margin-bottom: 12px; display: flex; justify-content: space-between; align-items: center;">
              <span style="font-size: 13px; color: var(--cinema-muted);">Is each column identified correctly? Adjust dropdowns if needed:</span>
              <span style="font-size: 11px; color: var(--cinema-teal);">✓ 1-Tap Auto-Mapped</span>
            </div>
            <table class="data-table" id="ca-preview-table" style="font-size: 12px;">
              <thead id="ca-preview-thead">
                <!-- Dropdown selectors injected here -->
              </thead>
              <tbody id="ca-preview-tbody">
                <!-- First 20 rows previewed here -->
              </tbody>
            </table>
          </div>
        </div>

        <!-- STEP 3: REVIEW CATEGORIES -->
        <div id="ca-step-3" class="ca-step-pane" style="display: none;">
          <div class="card card-glow-teal" style="margin-bottom: 20px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
            <div>
              <h3 style="color: var(--cinema-cream); margin: 0 0 4px 0;">Review Categorisation (23 Rules)</h3>
              <p style="font-size: 13px; color: var(--cinema-muted); margin: 0;">
