            <button class="btn btn-glass" id="ca-catfilter-review" onclick="caFilterLedger('REVIEW')">⚠️ Needs Your Review (<span id="ca-cnt-review">0</span>)</button>
            <select class="form-control" style="width: auto; font-size: 12px; min-height: 32px;" id="ca-catfilter-dropdown" onchange="caFilterLedger(this.value)">
              <option value="ALL">All Categories</option>
