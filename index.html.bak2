            <div class="movie-scene" id="m-scene-5">
              <span class="badge badge-teal">SCENE 05 // THE HERO</span>
              <h2 style="color: var(--cinema-teal); margin-top: 8px;">TOTAL TAKE-HOME WEALTH</h2>
              <div class="font-mono" style="font-size: 48px; font-weight: 700; color: var(--cinema-teal);">₹19,12,500</div>
