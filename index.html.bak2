      <!-- =======================================================================
           VIEW: AI ASSISTANT WITH VOICE INPUT
           ======================================================================= -->
      <div id="pane-assistant" class="view-pane">
        <div style="margin-bottom: 20px;">
          <h2>PAYPILOT COPILOT // VOICE &amp; TEXT ASSISTANT</h2>
          <p style="color: var(--cinema-muted);">Ask questions via microphone or text with offline rule-based fallbacks.</p>
        </div>

        <div class="card" style="height: 480px; display: flex; flex-direction: column;">
          <div id="chat-stream" style="flex: 1; overflow-y: auto; display: flex; flex-direction: column; gap: 12px; padding-right: 8px;">
            <div style="background: var(--bg-card-subtle); padding: 12px; border-radius: var(--radius-sm); max-width: 80%;">
              <strong>PayPilot AI:</strong> Hello! You can ask me anything about your payroll, tax savings, shop workers, or attendance. Tap the mic to speak!
            </div>
          </div>

          <div style="display: flex; gap: 10px; margin-top: 14px;">
            <input type="text" class="form-control" id="chat-user-input" placeholder="Type a payroll question..." onkeydown="if(event.key==='Enter') sendChatMsg()">
            <button class="btn btn-glass" onclick="listenVoiceInput()" title="Voice Input (Speech-to-Text)">🎙️</button>
            <button class="btn btn-orange" onclick="sendChatMsg()">Send</button>
