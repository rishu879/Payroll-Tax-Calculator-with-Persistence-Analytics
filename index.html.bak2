        <!-- Attendance Grid (Tap to toggle: Present / Half / Absent) -->
        <div class="card" style="margin-bottom: 24px;">
          <h3 style="color: var(--cinema-teal); margin-bottom: 12px;">Today's Worker Attendance (Tap to change)</h3>
          <div class="grid-3" id="shop-attendance-grid">
            <!-- Rendered by JS -->
          </div>
        </div>

        <div class="grid-2">
          <!-- Vendor & Material Payments List -->
          <div class="card">
            <h3 style="color: var(--cinema-gold); margin-bottom: 12px;">Vendor &amp; Supply Due List</h3>
