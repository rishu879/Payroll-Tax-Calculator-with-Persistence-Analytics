          <div class="card">
            <div class="form-group">
              <label class="form-label">Choose Occasion</label>
              <select class="form-control" id="bonus-festival">
                <option value="Diwali">Diwali Festival Bonus</option>
                <option value="Eid">Eid Mubarak Bonus</option>
                <option value="Pongal">Pongal / Makar Sankranti</option>
                <option value="Christmas">Christmas / Year-End Incentive</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Bonus Percentage (% of Annual Basic)</label>
              <input type="number" class="form-control font-mono" id="bonus-pct" value="8.33" oninput="runBonusCalc()">
            </div>
          </div>

          <div class="card card-glow-orange">
            <h4 style="color: var(--cinema-orange); margin-bottom: 12px;">Total Company Budget Required</h4>
            <div class="font-mono money-val" style="font-size: 30px; font-weight: 700; color: var(--cinema-orange);" id="bonus-total-budget">₹1,80,000</div>
            <p style="font-size: 12px; color: var(--cinema-muted); margin-top: 6px;">Average payout per employee: ₹18,000 across 10 eligible team members.</p>
          </div>
        </div>
      </div>

      <!-- =======================================================================
           VIEW: FULL & FINAL (F&F) SETTLEMENT
           ======================================================================= -->
      <div id="pane-ff-settlement" class="view-pane">
        <div style="margin-bottom: 20px;">
          <h2>FULL &amp; FINAL (F&amp;F) SETTLEMENT</h2>
          <p style="color: var(--cinema-muted);">Statutory separation math: Gratuity ($15 \times B \times Y / 26$), Leave Encashment ($B/26$), &amp; Notice Recovery ($G/30$).</p>
        </div>

        <div class="grid-2">
          <div class="card">
            <div class="form-group">
              <label class="form-label">Monthly Basic Salary (₹)</label>
              <input type="number" class="form-control font-mono" id="ff-basic" value="60000" oninput="runFfCalc()">
            </div>
            <div class="form-group">
              <label class="form-label">Completed Years of Service</label>
              <input type="number" class="form-control font-mono" id="ff-tenure" value="6" oninput="runFfCalc()">
            </div>
            <div class="form-group">
              <label class="form-label">Unused Earned Leave Balance (Days)</label>
              <input type="number" class="form-control font-mono" id="ff-leave-days" value="18" oninput="runFfCalc()">
            </div>
          </div>

          <div class="card card-glow-teal">
            <h4 style="color: var(--cinema-teal); margin-bottom: 12px;">Settlement Statement</h4>
            <div style="font-size: 14px; line-height: 1.8;">
              Gratuity Payout: <strong class="font-mono money-val" id="ff-gratuity">₹2,07,692</strong><br>
              Leave Encashment: <strong class="font-mono money-val" id="ff-leave-val">₹41,538</strong><br>
              <div style="border-top: 1px solid var(--border-subtle); margin-top: 8px; padding-top: 8px;">
                <span style="font-weight: 700; color: var(--cinema-teal);">Total Net Payable:</span>
                <strong class="font-mono money-val" style="color: var(--cinema-teal); font-size: 22px;" id="ff-net-total">₹2,49,230</strong>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- =======================================================================
           VIEW: ONBOARDING CHECKLIST
           ======================================================================= -->
      <div id="pane-onboarding-check" class="view-pane">
        <div style="margin-bottom: 20px;">
          <h2>NEW EMPLOYEE ONBOARDING CHECKLIST</h2>
          <p style="color: var(--cinema-muted);">Tick off verification milestones before issuing the first salary run.</p>
